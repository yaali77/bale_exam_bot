# ===== Database =====
POSTGRES_USER=exam_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=exam_results
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://exam_admin:change_me_strong_password@db:5432/exam_results

# ===== Bale Bot =====
BALE_BOT_TOKEN=your_bale_bot_token_here
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_WEBHOOK_SECRET=change_me_webhook_secret
BALE_WEBHOOK_PATH=/webhook/bale
PUBLIC_BASE_URL=https://yourdomain.example.com

# ===== Security =====
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ===== App =====
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ORGANIZATION_NAME=Ø¢Ø³ØªØ§Ù† Ù…Ù‚Ø¯Ø³

# ===== Rate Limiting =====
RATE_LIMIT_PER_MINUTE=20

# ===== Files =====
PDF_STORAGE_PATH=/app/storage/pdf
EXCEL_STORAGE_PATH=/app/storage/excel
QR_STORAGE_PATH=/app/storage/qr

# ===== Backup =====
BACKUP_ENABLED=true
BACKUP_CRON_HOUR=3
BACKUP_RETENTION_DAYS=14
